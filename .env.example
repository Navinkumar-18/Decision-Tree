# ---------------------------------------------------------------------------
# Frontend (Vite) — read at BUILD time by src/services/api.ts
# ---------------------------------------------------------------------------
# Local development: leave unset (or copy this file to .env). The dev server
# runs on :3000 and Vite's dev proxy forwards /api to http://localhost:8000
# (see server.proxy in vite.config.ts).
#
# Deployment (Vercel): REQUIRED — set to your deployed Render backend origin:
#   VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
